{
  "name": "confidential-lms",
  "private": true,
  "version": "1.0.0",
  "description": "Plateforme LMS avec protection anti-copie renforcee — monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lms/web dev",
    "build": "pnpm --filter @lms/core build && pnpm --filter @lms/web build",
    "preview": "pnpm --filter @lms/web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
